@model IEnumerable<Usuario>
@using System.Globalization
@{
    ViewData["Title"] = "Usuarios";
    var es = CultureInfo.GetCultureInfo("es-DO");
}

<h1>Este es mi primer CRUD en ASP.NET</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.Perfil)</th>
            <th>@Html.DisplayNameFor(m => m.Email)</th>
            <th>@Html.DisplayNameFor(m => m.Edad)</th>
            <th>@Html.DisplayNameFor(m => m.Activo)</th>
            <th>@Html.DisplayNameFor(m => m.FechaRegistro)</th>
            <th>@Html.DisplayNameFor(m => m.Balance)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.Perfil</td>
                <td><a href="mailto:@u.Email">@u.Email</a></td>
                <td>@u.Edad</td>
                <td>@(u.Activo ? "Si" : "No")</td>
                <td>@u.FechaRegistro.ToString("MMMM dd, hh:mm tt", es)</td>
                <td>@u.Balance.ToString("$#,0.00", CultureInfo.InvariantCulture)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@u.Id">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@u.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
